{
  "name": "WireTap",
  "version": "0.0.1",
  "artifactId": "WireTap",
  "group": "com.vized.project",
  "relativePath": "WireTap",
  "type": "integration",
  "camelVersion": "latest",
  "runtime": "camel-main",
  "camel": {
    "routes": {
      "WireTap.camel.yaml": {
        "patient-vital-signs-processor": {
          "id": "patient-vital-signs-processor",
          "breakpoints": [],
          "from": [
            {
              "uri": "timer",
              "id": "vital-signs-timer"
            }
          ],
          "to": [
            {
              "uri": "direct:processVitalSigns",
              "id": "main-processing-flow"
            }
          ]
        },
        "main-vital-signs-processing": {
          "id": "main-vital-signs-processing",
          "breakpoints": [],
          "from": [
            {
              "uri": "direct:processVitalSigns",
              "id": "process-vital-signs-entry"
            }
          ],
          "to": [
            {
              "uri": "direct:updateDashboard",
              "id": "dashboard-update"
            }
          ]
        },
        "research-data-collection-route": {
          "id": "research-data-collection-route",
          "breakpoints": [],
          "from": [
            {
              "uri": "direct:researchDataCollection",
              "id": "research-data-entry"
            }
          ],
          "to": [
            {
              "uri": "file:research-data/collected",
              "id": "research-file-output"
            }
          ]
        },
        "compliance-audit-route": {
          "id": "compliance-audit-route",
          "breakpoints": [],
          "from": [
            {
              "uri": "direct:complianceAudit",
              "id": "compliance-audit-entry"
            }
          ],
          "to": [
            {
              "uri": "file:compliance-audit/critical-events",
              "id": "compliance-file-output"
            }
          ]
        },
        "predictive-analytics-route": {
          "id": "predictive-analytics-route",
          "breakpoints": [],
          "from": [
            {
              "uri": "direct:predictiveAnalytics",
              "id": "analytics-entry"
            }
          ],
          "to": [
            {
              "uri": "file:analytics-data/patterns",
              "id": "analytics-file-output"
            }
          ]
        },
        "family-notification-route": {
          "id": "family-notification-route",
          "breakpoints": [],
          "from": [
            {
              "uri": "direct:familyNotification",
              "id": "family-notification-entry"
            }
          ],
          "to": [
            {
              "uri": "file:family-notifications/critical-alerts",
              "id": "family-notification-output"
            }
          ]
        },
        "dashboard-update-route": {
          "id": "dashboard-update-route",
          "breakpoints": [],
          "from": [
            {
              "uri": "direct:updateDashboard",
              "id": "dashboard-update-entry"
            }
          ],
          "to": [
            {
              "uri": "file:dashboard-updates/real-time",
              "id": "dashboard-file-output"
            }
          ]
        }
      }
    },
    "beans": {
      "WireTap.camel.yaml": []
    }
  },
  "environments": {
    "default": [
      "wire.tap.research.enabled",
      "wire.tap.compliance.enabled",
      "wire.tap.analytics.enabled",
      "wire.tap.family.notifications.enabled",
      "research.data.retention.days",
      "compliance.audit.retention.days",
      "analytics.data.retention.days",
      "family.notifications.retention.days",
      "vital.signs.heart.rate.critical.high",
      "vital.signs.heart.rate.critical.low",
      "vital.signs.oxygen.saturation.critical",
      "vital.signs.temperature.critical",
      "vital.signs.blood.pressure.systolic.critical",
      "monitoring.enabled",
      "monitoring.interval.seconds"
    ]
  }
}